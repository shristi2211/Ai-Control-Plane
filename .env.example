# ============================================
# AI Control Plane — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.

# ---------- PostgreSQL ----------
POSTGRES_DB=ai_control_plane
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- AI / LLM API Keys ----------
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- Internal Shared Secret ----------
INTERNAL_API_KEY=

# ---------- Usage Quotas ----------
DAILY_TOKEN_LIMIT=10000
